              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time 200..600 ms per request" enabled="true">
          <stringProp name="ConstantTimer.delay">${__P(think,200)}</stringProp>
          <stringProp name="RandomTimer.range">${__P(jitter,400)}</stringProp>
        </UniformRandomTimer>
        <hashTree />
        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate HTTP status, JSON and persisted values" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

// Use vars.get(), not JMeter ${...} substitutions, so compiled scripts remain safe to cache.
try {
    String label = prev.getSampleLabel()
    String expected = label.startsWith('02') ? '201' : label.startsWith('06') ? '204' : '200'
    assert prev.getResponseCode() == expected : 'HTTP ' + prev.getResponseCode() + ', expected ' + expected
    if (label.startsWith('06')) {
        assert prev.getResponseData().length == 0 : 'DELETE must have an empty body'
    } else {
        def data = new JsonSlurper().parseText(prev.getResponseDataAsString())
        if (label.startsWith('01')) {
            assert data.items instanceof List
            assert data.limit == vars.get('limit').toInteger()
            assert data.offset == vars.get('offset').toInteger()
            assert data.items.size() &lt;= data.limit
            long last = -1
            data.items.each { task -&gt;
                assert task.id instanceof Number &amp;&amp; task.id &gt; last
                assert task.title instanceof String &amp;&amp; task.title.toLowerCase().contains(vars.get('category'))
                assert task.priority &gt;= vars.get('minPriority').toInteger() &amp;&amp; task.priority &lt;= 5
                assert task.status == vars.get('filterStatus')
                last = task.id
            }
        } else {
            assert data.id instanceof Number &amp;&amp; data.id &gt; 0
            if (label.startsWith('02')) vars.put('taskId', data.id.toString())
            assert data.id.toString() == vars.get('taskId')
            boolean updated = label.startsWith('04') || label.startsWith('05')
            assert data.title == vars.get(updated ? 'updatedTitle' : 'title')
            assert data.priority == vars.get(updated ? 'updatedPriority' : 'priority').toInteger()
            assert data.status == (updated ? 'DONE' : 'OPEN')
        }
    }
} catch (Throwable problem) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(problem.toString())
}
</stringProp>
        </JSR223Assertion>
        <hashTree />
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="01 GET list" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8084)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/tasks?status=${filterStatus}&amp;minPriority=${minPriority}&amp;q=${category}&amp;limit=${limit}&amp;offset=${offset}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">3000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Prepare unique data for this lifecycle" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put('title', 'load-' + java.util.UUID.randomUUID().toString() + '-' + vars.get('category')); vars.put('updatedTitle', vars.get('title') + '-done'); vars.put('updatedPriority', String.valueOf(Integer.parseInt(vars.get('priority')) % 5 + 1)); vars.put('limit', ctx.getThreadNum() % 2 == 0 ? '10' : '20'); vars.put('offset', String.valueOf(java.util.concurrent.ThreadLocalRandom.current().nextInt(3) * 10)); vars.remove('taskId');</stringProp>
          </JSR223PreProcessor>
          <hashTree />
        </hashTree>
